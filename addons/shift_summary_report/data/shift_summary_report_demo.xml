<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_shift_report_1" model="shift.summary.report">
            <field name="name">Рапорт дневной смены — Участок ЧПУ</field>
            <field name="date" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="shift_name">day</field>
            <field name="director_email">director@factory.com</field>
            <field name="planned_qty">500.0</field>
            <field name="produced_qty">520.0</field>
            <field name="scrap_qty">10.0</field>
            <field name="critical_downtime_minutes">15.0</field>
            <field name="state">confirmed</field>
            <field name="sent_date" eval="(datetime.now() - timedelta(days=2))"/>
            <field name="notes">Смена выполнила план с превышением. Небольшой простой на станочном участке устранили в течение 15 минут.</field>
        </record>

        <record id="demo_shift_report_2" model="shift.summary.report">
            <field name="name">Рапорт ночной смены — Линия сборки</field>
            <field name="date" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="shift_name">night</field>
            <field name="director_email">director@factory.com</field>
            <field name="planned_qty">400.0</field>
            <field name="produced_qty">380.0</field>
            <field name="scrap_qty">8.0</field>
            <field name="critical_downtime_minutes">45.0</field>
            <field name="state">confirmed</field>
            <field name="sent_date" eval="(datetime.now() - timedelta(days=1))"/>
            <field name="notes">Было зафиксировано время аварийного простоя (45 мин) из-за задержки поставок заготовок со склада.</field>
        </record>

        <record id="demo_shift_report_3" model="shift.summary.report">
            <field name="name">Рапорт смены — Сегодняшняя смена</field>
            <field name="date" eval="datetime.now().strftime('%Y-%m-%d')"/>
            <field name="shift_name">shift_1</field>
            <field name="director_email">director@factory.com</field>
            <field name="planned_qty">600.0</field>
            <field name="produced_qty">590.0</field>
            <field name="scrap_qty">5.0</field>
            <field name="critical_downtime_minutes">0.0</field>
            <field name="state">draft</field>
            <field name="notes">Текущая смена близка к завершению. Все станки работали без критических простоев.</field>
        </record>
    </data>
</odoo>
