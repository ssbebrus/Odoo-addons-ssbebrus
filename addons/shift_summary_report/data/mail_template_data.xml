<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_shift_report" model="mail.template">
            <field name="name">Сводный рапорт смены для директора</field>
            <field name="model_id" ref="shift_summary_report.model_shift_summary_report"/>
            <field name="subject">Рапорт смены за {{ object.date }} ({{ dict(object._fields['shift_name'].selection).get(object.shift_name) }})</field>
            <field name="email_to">{{ object.director_email }}</field>
            <field name="description">Автоматическое уведомление директора о результатах прошедшей смены</field>
            <field name="body_html" type="html">
                <div style="margin:0px; padding:20px; background-color:#f4f6f9; font-family:Arial,sans-serif;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:650px; margin:0 auto; background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 4px 10px rgba(0,0,0,0.05);">
                        <tr>
                            <td style="background-color:#1e293b; color:#ffffff; padding:24px; text-align:center;">
                                <h2 style="margin:0; font-size:22px; font-weight:600;">📊 Сводный рапорт смены</h2>
                                <p style="margin:6px 0 0 0; font-size:14px; opacity:0.85;">Дата: <t t-out="object.date"/> | Смена: <t t-out="dict(object._fields['shift_name'].selection).get(object.shift_name)"/></p>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:24px;">
                                <p style="font-size:15px; color:#334155; margin-top:0;">Уважаемый директор,</p>
                                <p style="font-size:14px; color:#475569;">Смена закрыта. Ниже представлены ключевые показатели работы производства:</p>

                                <table border="0" cellpadding="12" cellspacing="0" width="100%" style="margin-top:16px; border-collapse:collapse; background-color:#f8fafc; border-radius:6px;">
                                    <tr style="border-bottom:1px solid #e2e8f0;">
                                        <td style="font-weight:bold; color:#334155;">📦 Общий объем выпуска деталей:</td>
                                        <td style="text-align:right; font-weight:bold; color:#0284c7; font-size:16px;">
                                            <t t-out="object.produced_qty"/> шт.
                                        </td>
                                    </tr>
                                    <tr style="border-bottom:1px solid #e2e8f0;">
                                        <td style="font-weight:bold; color:#334155;">🎯 Выполнение плана:</td>
                                        <td style="text-align:right; font-weight:bold; color:#16a34a; font-size:16px;">
                                            <t t-out="object.plan_execution_rate"/>%
                                        </td>
                                    </tr>
                                    <tr style="border-bottom:1px solid #e2e8f0;">
                                        <td style="font-weight:bold; color:#334155;">⚠️ Процент брака за день:</td>
                                        <td style="text-align:right; font-weight:bold; color:#dc2626; font-size:16px;">
                                            <t t-out="object.scrap_percentage"/>%
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; color:#334155;">⏱️ Время критических простоев:</td>
                                        <td style="text-align:right; font-weight:bold; color:#d97706; font-size:16px;">
                                            <t t-out="object.critical_downtime_minutes"/> мин.
                                        </td>
                                    </tr>
                                </table>

                                <t t-if="object.notes">
                                    <div style="margin-top:20px; padding:12px; background-color:#f1f5f9; border-left:4px solid #0284c7; border-radius:4px;">
                                        <strong>Комментарии начальника цеха:</strong><br/>
                                        <t t-out="object.notes"/>
                                    </div>
                                </t>

                                <hr style="margin:24px 0; border:0; border-top:1px solid #e2e8f0;"/>
                                <p style="font-size:12px; color:#94a3b8; text-align:center; margin:0;">
                                    Начальник цеха: <t t-out="object.manager_id.name"/><br/>
                                    Автоматический рапорт сформирован системой Odoo ERP.
                                </p>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
