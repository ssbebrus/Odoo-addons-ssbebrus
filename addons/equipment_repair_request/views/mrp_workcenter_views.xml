<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_form_inherit_repair" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.repair</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="🚨 Сообщить о поломке" name="action_report_breakdown" type="object" class="btn-danger"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_repair_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                    <field name="repair_request_count" widget="statinfo" string="Заявки на ремонт"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
