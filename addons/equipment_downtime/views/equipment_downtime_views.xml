<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_downtime_tree" model="ir.ui.view">
        <field name="name">equipment.downtime.list</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <list string="Equipment Downtimes">
                <field name="date"/>
                <field name="workcenter_id"/>
                <field name="reason_id"/>
                <field name="duration"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_downtime_form" model="ir.ui.view">
        <field name="name">equipment.downtime.form</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <form string="Equipment Downtime">
                <sheet>
                    <group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="date"/>
                            <field name="reason_id"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_downtime" model="ir.actions.act_window">
        <field name="name">Equipment Downtimes</field>
        <field name="res_model">equipment.downtime</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_equipment_downtime"
              name="Downtime Records"
              parent="mrp.menu_mrp_manufacturing"
              action="action_equipment_downtime"
              sequence="50"/>
</odoo>
