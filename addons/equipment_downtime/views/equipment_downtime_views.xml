<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_downtime_tree" model="ir.ui.view">
        <field name="name">equipment.downtime.list</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <list string="Equipment Downtimes">
                <field name="date"/>
                <field name="workcenter_id"/>
                <field name="reason_id"/>
                <field name="duration"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_downtime_form" model="ir.ui.view">
        <field name="name">equipment.downtime.form</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <form string="Equipment Downtime">
                <sheet>
                    <group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="date"/>
                            <field name="reason_id"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_downtime_reason_pie_graph" model="ir.ui.view">
        <field name="name">equipment.downtime.reason.pie.graph</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <graph string="Причины простоев оборудования" type="pie" sample="1">
                <field name="reason_id"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_equipment_downtime_monthly_graph" model="ir.ui.view">
        <field name="name">equipment.downtime.monthly.graph</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <graph string="Загрузка и простои оборудования" type="bar" sample="1">
                <field name="workcenter_id"/>
                <field name="reason_id"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_equipment_downtime_monthly_pivot" model="ir.ui.view">
        <field name="name">equipment.downtime.monthly.pivot</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <pivot string="Аналитика простоев оборудования">
                <field name="workcenter_id" type="row"/>
                <field name="reason_id" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_equipment_downtime_search" model="ir.ui.view">
        <field name="name">equipment.downtime.search</field>
        <field name="model">equipment.downtime</field>
        <field name="arch" type="xml">
            <search>
                <field name="workcenter_id"/>
                <field name="reason_id"/>
                <field name="date"/>
                <filter string="Есть простоя (мин)" name="has_duration" domain="[('duration', '&gt;', 0)]"/>
                <separator/>
                <filter string="Оборудование / Станок" name="group_by_workcenter" context="{'group_by': 'workcenter_id'}"/>
                <filter string="Причина простоя" name="group_by_reason" context="{'group_by': 'reason_id'}"/>
                <filter string="Дата" name="group_by_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_downtime" model="ir.actions.act_window">
        <field name="name">Equipment Downtimes</field>
        <field name="res_model">equipment.downtime</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_equipment_downtime_monthly_report" model="ir.actions.act_window">
        <field name="name">Отчет по загрузке оборудования</field>
        <field name="res_model">equipment.downtime</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_workcenter': 1}</field>
        <field name="search_view_id" ref="view_equipment_downtime_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Нет данных о простоях оборудования за этот период.
            </p>
            <p>
                Отчет по загрузке оборудования строится на основе простоев, фиксируемых мастером цеха в конце смены.
            </p>
        </field>
    </record>

    <menuitem id="menu_equipment_downtime"
              name="Downtime Records"
              parent="mrp.menu_mrp_manufacturing"
              action="action_equipment_downtime"
              sequence="50"/>

    <menuitem id="menu_equipment_downtime_report"
              name="Отчет по загрузке оборудования"
              parent="mrp.menu_mrp_reporting"
              action="action_equipment_downtime_monthly_report"
              sequence="15"/>
</odoo>
