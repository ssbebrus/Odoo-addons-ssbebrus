<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_downtime_reason_tree" model="ir.ui.view">
        <field name="name">downtime.reason.list</field>
        <field name="model">downtime.reason</field>
        <field name="arch" type="xml">
            <list string="Downtime Reasons">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_downtime_reason_form" model="ir.ui.view">
        <field name="name">downtime.reason.form</field>
        <field name="model">downtime.reason</field>
        <field name="arch" type="xml">
            <form string="Downtime Reason">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_downtime_reason" model="ir.actions.act_window">
        <field name="name">Downtime Reasons</field>
        <field name="res_model">downtime.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_downtime_reason"
              name="Downtime Reasons"
              parent="mrp.menu_mrp_configuration"
              action="action_downtime_reason"
              sequence="100"/>
</odoo>
