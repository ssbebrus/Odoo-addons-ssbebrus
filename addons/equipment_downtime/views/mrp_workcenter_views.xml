<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_inherit_downtime" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.downtime</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_add_downtime_wizard"
                        string="Добавить простой"
                        type="object"
                        class="btn-warning"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_downtimes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o">
                    <field name="downtime_count" widget="statinfo" string="Downtimes"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Downtimes">
                    <group>
                        <field name="total_downtime_minutes" readonly="1"/>
                    </group>
                    <field name="downtime_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="reason_id"/>
                            <field name="duration"/>
                            <field name="user_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
