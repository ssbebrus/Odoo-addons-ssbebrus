<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_inherit_downtime" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.downtime</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_add_downtime_wizard"
                            string="Добавить простой"
                            type="object"
                            class="btn-warning"/>
                    <button name="action_open_downtime_reason_pie"
                            string="Диаграмма причин простоя"
                            type="object"
                            class="btn-info"
                            icon="fa-pie-chart"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="replace">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_downtimes"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clock-o">
                        <field name="downtime_count" widget="statinfo" string="Простои"/>
                    </button>
                    <button name="action_open_downtime_reason_pie"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pie-chart">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Причины</span>
                            <span class="o_stat_text">простоя (%)</span>
                        </div>
                    </button>
                    <button name="action_view_downtimes"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calculator">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="downtime_adjusted_oee"/>%
                            </span>
                            <span class="o_stat_text">Скорр. OEE</span>
                        </div>
                    </button>
                    <button name="action_view_downtimes"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-hourglass-half">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="net_working_time"/> мин
                            </span>
                            <span class="o_stat_text">Чистое время</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Простои оборудования (OEE)">
                    <group>
                        <group string="Метрики эффективности">
                            <field name="total_downtime_minutes" string="Всего простоев (мин)" readonly="1"/>
                            <field name="net_working_time" string="Чистое рабочее время (мин)" readonly="1"/>
                        </group>
                        <group string="Корректировка OEE">
                            <field name="downtime_adjusted_oee" string="Скорректированный OEE (%)" readonly="1" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Аналитика причин простоев">
                        <field name="downtime_reason_summary" string="Структура простоев (%)" readonly="1"/>
                    </group>
                    <separator string="История нештатных остановок"/>
                    <field name="downtime_ids">
                        <list editable="bottom">
                            <field name="date" string="Дата"/>
                            <field name="reason_id" string="Причина"/>
                            <field name="duration" string="Длительность (мин)"/>
                            <field name="user_id" string="Зафиксировал"/>
                            <field name="notes" string="Примечания"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
