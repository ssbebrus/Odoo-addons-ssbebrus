<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_inherit_downtime" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.downtime</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_add_downtime_wizard"
                            string="Добавить простой"
                            type="object"
                            class="btn-warning"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_downtimes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o">
                    <field name="downtime_count" widget="statinfo" string="Простои"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Простои оборудования (OEE)">
                    <group>
                        <group string="Метрики эффективности">
                            <field name="total_downtime_minutes" string="Всего простоев (мин)" readonly="1"/>
                            <field name="net_working_time" string="Чистое рабочее время (мин)" readonly="1"/>
                        </group>
                        <group string="Корректировка OEE">
                            <field name="downtime_adjusted_oee" string="Скорректированный OEE (%)" readonly="1" widget="progressbar"/>
                        </group>
                    </group>
                    <separator string="История нештатных остановок"/>
                    <field name="downtime_ids">
                        <list editable="bottom">
                            <field name="date" string="Дата"/>
                            <field name="reason_id" string="Причина"/>
                            <field name="duration" string="Длительность (мин)"/>
                            <field name="user_id" string="Зафиксировал"/>
                            <field name="notes" string="Примечания"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
