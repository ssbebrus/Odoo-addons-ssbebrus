<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_add_downtime_wizard_form" model="ir.ui.view">
        <field name="name">add.downtime.wizard.form</field>
        <field name="model">add.downtime.wizard</field>
        <field name="arch" type="xml">
            <form string="Добавить простой оборудования">
                <sheet>
                    <group>
                        <group>
                            <field name="workcenter_id" readonly="1" options="{'no_open': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="duration" string="Длительность (мин)"/>
                            <field name="reason_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Укажите подробности или причину нештатной остановки..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Сохранить простой" name="action_add_downtime" type="object" class="btn-primary"/>
                    <button string="Отмена" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_downtime_wizard" model="ir.actions.act_window">
        <field name="name">Добавить простой</field>
        <field name="res_model">add.downtime.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
